{
  "name": "orbit-monorepo",
  "private": true,
  "description": "Orbit: self-hostable, always-on, goal-driven AI agents powered by Claude Code and the Claude Agent SDK",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern 'apps/**' --ignore-pattern 'plugins/**' --max-warnings=0 && eslint apps --max-warnings=0 && eslint plugins --max-warnings=0",
    "lint:fix": "eslint . --ignore-pattern 'apps/**' --ignore-pattern 'plugins/**' --fix && eslint apps --fix && eslint plugins --fix",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel --aggregate-output typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "ORBIT_LIVE=1 vitest run --config vitest.live.config.ts",
    "orbit": "tsx apps/orbit-tui/src/bin.ts",
    "orbitd": "tsx apps/orbitd/src/bin.ts",
    "test:e2e": "pnpm --filter @orbit/app build && pnpm --filter @orbit/app e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
